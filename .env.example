# Copy to .env and fill in. .env is gitignored — never commit real values.

# === Mode B (MongoDB) only ===

# Local mongo (the mongodb service in docker-compose-with-db.yml):
MONGODB_URL=mongodb://changeme:changeme@mongodb:27017/

# Or MongoDB Atlas:
# MONGODB_URL=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/

MONGO_INITDB_ROOT_USERNAME=changeme
MONGO_INITDB_ROOT_PASSWORD=changeme

# === Frontend build-time (optional) ===
# Baked into the bundle at `npm run build` / docker build time.
# Defaults to http://localhost:5050 if unset.
# VUE_APP_API_URL=https://api.games.your-domain.com
